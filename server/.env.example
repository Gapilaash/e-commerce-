# MongoDB
# Local:  mongodb://127.0.0.1:27017/mdark
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mdark
MONGODB_URI=mongodb://127.0.0.1:27017/mdark

# Server
PORT=5000

# Clerk (used by server/middleware/auth.js to verify session tokens)
CLERK_SECRET_KEY=your_clerk_secret_key

# Stripe (used by server/routes/payments.js — optional, only needed for real card payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
