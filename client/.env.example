# Rename this file to .env before running the frontend (npm run dev)
# All variables MUST be prefixed with VITE_

# ---------- Clerk (required) ----------
# 1. Sign up free at https://clerk.com
# 2. Create a new application → enable "Google" under Social connections
#    (No Google Cloud Console needed — Clerk handles it all!)
# 3. Go to API Keys → copy "Publishable Key" below
# 4. Copy "Secret Key" into server/.env as CLERK_SECRET_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx


# ---------- Stripe (optional) ----------
# Leave blank to keep using the built-in dummy payment simulator.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_test_key_here
